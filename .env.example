# ─── Database (matches docker-compose.yml defaults) ───────────────────────────
DATABASE_URL=postgresql://lawfirm:lawfirm@localhost:5432/lawfirm?schema=public
POSTGRES_USER=lawfirm
POSTGRES_PASSWORD=lawfirm
POSTGRES_DB=lawfirm
POSTGRES_PORT=5432

# ─── API (apps/api) ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3001
# Optional: cookie domain for production (e.g. .lawfirm.mn). Leave empty in dev.
COOKIE_DOMAIN=

# ─── MinIO / S3 (matches docker-compose.yml defaults) ────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=law-firm-documents

# ─── Web (apps/web) ───────────────────────────────────────────────────────────
# Browser-side API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API base URL (SSR / middleware). Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000
