# ─── Database (matches docker-compose.yml defaults) ───────────────────────────
DATABASE_URL=postgresql://lawfirm:lawfirm@localhost:5432/lawfirm?schema=public
POSTGRES_USER=lawfirm
POSTGRES_PASSWORD=lawfirm
POSTGRES_DB=lawfirm
POSTGRES_PORT=5432

# ─── API (apps/api) ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Seconds a just-rotated refresh token may be sent again by another tab without logging the user out everywhere (0 = off).
REFRESH_REUSE_GRACE_SECONDS=30
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3001
# Optional: cookie domain for production (e.g. .lawfirm.mn). Leave empty in dev.
COOKIE_DOMAIN=
# Global rate limit (requests per minute per IP). Raise only for e2e runs from one machine.
THROTTLE_LIMIT=120
# Daily reminders (server local time). Disable with REMINDERS_ENABLED=false; never scheduled when NODE_ENV=test.
REMINDERS_ENABLED=true
REMINDERS_CRON="0 0 8 * * *"

# Path prefix the browser sees in front of the API. Empty in dev (the browser calls the API
# directly); /api in production, where the web app proxies the API same-origin.
COOKIE_PATH_PREFIX=
# Proxy hops in front of the API; only used when NODE_ENV=production. Railway: 2 (edge → web → api).
TRUST_PROXY_HOPS=1

# ─── Object storage: Cloudflare R2 (S3 API) ──────────────────────────────────
# Local dev points the same S3 client at MinIO from docker-compose.yml.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=law-firm-documents
# Browser-facing base URL of the bucket ROOT for public objects (post cover images).
# MinIO: http://localhost:9000/<bucket>. R2: https://pub-xxxx.r2.dev or your custom domain.
R2_PUBLIC_URL=http://localhost:9000/law-firm-documents
# docker-compose only (host ports for the local MinIO container)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Web (apps/web) ───────────────────────────────────────────────────────────
# Browser-side API base URL. `/api` = same-origin proxy (see next.config.ts rewrites).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API base URL (SSR, middleware, and the target of the /api proxy). Must be absolute.
API_URL=http://localhost:4000

# ─── Production example (Railway: web and api are two services) ──────────────
# api service:
#   NODE_ENV=production
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   PORT=4000                     (Railway injects it)
#   CORS_ORIGIN=https://<web>.up.railway.app
#   COOKIE_PATH_PREFIX=/api       browser sees the API under /api, so the refresh cookie is /api/auth
#   TRUST_PROXY_HOPS=2            Railway edge → web rewrite → api
#   R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY   R2 API token (Object Read & Write)
#   R2_BUCKET=law-firm-documents
#   R2_PUBLIC_URL=https://pub-xxxx.r2.dev     (or https://cdn.example.mn)
# web service:
#   NODE_ENV=production
#   NEXT_PUBLIC_API_URL=/api      same-origin; *.up.railway.app is a public suffix, so a
#                                 cross-host SameSite=Lax cookie would never be sent
#   API_URL=http://api.railway.internal:4000  private network target of the /api rewrite
