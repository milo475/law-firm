{
  "name": "@law-firm/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma client, zod schemas and shared types for the law firm monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./labels": {
      "types": "./dist/labels.d.ts",
      "default": "./dist/labels.js"
    },
    "./enums": {
      "types": "./dist/generated/prisma/enums.d.ts",
      "default": "./dist/generated/prisma/enums.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-prisma-assets.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "rm -rf dist src/generated",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:clean": "tsx prisma/clean-test-data.ts",
    "db:admin": "tsx prisma/create-admin.ts",
    "db:purge-demo": "tsx prisma/purge-demo.ts",
    "db:seed-content": "tsx prisma/seed-content.ts",
    "db:studio": "prisma studio",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
