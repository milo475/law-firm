// Law firm platform — Prisma 7 schema (PostgreSQL)
// Connection URL lives in prisma.config.ts (DATABASE_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum PostCategory {
  NEWS
  ADVICE
  LEGAL_UPDATE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CaseType {
  CIVIL
  CRIMINAL
  FAMILY
  BUSINESS
  LABOR
  REAL_ESTATE
  OTHER
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  WAITING
  CLOSED
}

enum CaseEventType {
  NOTE
  HEARING
  MEETING
  DEADLINE
  STATUS_CHANGE
  DOCUMENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_CONFIRMATION
  PAID
  OVERDUE
  CANCELLED
}

enum ContactStatus {
  NEW
  CONTACTED
  CLOSED
}

enum DocumentRequestStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum CaseMemberRole {
  LEAD
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Users & auth ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(CLIENT)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens            RefreshToken[]
  lawyerProfile            LawyerProfile?
  posts                    Post[]
  clientCases              Case[]            @relation("CaseClient")
  lawyerCases              Case[]            @relation("CaseLawyer")
  createdEvents            CaseEvent[]
  uploadedDocuments        Document[]
  requestedDocuments       DocumentRequest[] @relation("DocumentRequestRequester")
  reviewedDocumentRequests DocumentRequest[] @relation("DocumentRequestReviewer")
  sentMessages             Message[]
  confirmedInvoices        Invoice[]         @relation("InvoiceConfirmer")
  caseMemberships          CaseMember[]      @relation("CaseMemberUser")
  addedCaseMembers         CaseMember[]      @relation("CaseMemberAddedBy")
  assignedTasks            Task[]            @relation("TaskAssignee")
  createdTasks             Task[]            @relation("TaskCreator")
  taskComments             TaskComment[]     @relation("TaskCommentAuthor")
  notifications            Notification[]    @relation("NotificationRecipient")
  actedNotifications       Notification[]    @relation("NotificationActor")
  auditLogs                AuditLog[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LawyerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  bio               String   @db.Text
  specializations   String[] @default([])
  education         String   @db.Text
  yearsOfExperience Int      @default(0)
  isPublic          Boolean  @default(true)
  sortOrder         Int      @default(0)

  @@index([isPublic, sortOrder])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Post {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  slug          String       @unique
  excerpt       String
  content       String       @db.Text
  coverImageUrl String?
  category      PostCategory
  status        PostStatus   @default(DRAFT)
  publishedAt   DateTime?
  authorId      String       @db.Uuid
  author        User         @relation(fields: [authorId], references: [id])
  viewCount     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([slug, status, publishedAt])
  @@index([status, category, publishedAt])
}

// ─── Cases ───────────────────────────────────────────────────────────────────

model Case {
  id          String     @id @default(uuid()) @db.Uuid
  caseNumber  String     @unique // format: LF-2026-0001
  title       String
  description String?    @db.Text
  type        CaseType
  status      CaseStatus @default(NEW)
  clientId    String     @db.Uuid
  client      User       @relation("CaseClient", fields: [clientId], references: [id])
  lawyerId    String     @db.Uuid
  lawyer      User       @relation("CaseLawyer", fields: [lawyerId], references: [id])
  openedAt    DateTime   @default(now())
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events           CaseEvent[]
  documents        Document[]
  invoices         Invoice[]
  documentRequests DocumentRequest[]
  messages         Message[]
  members          CaseMember[]
  tasks            Task[]

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
}

/// Staff on a case team. The case's lawyerId is always its single LEAD member.
model CaseMember {
  id        String         @id @default(uuid()) @db.Uuid
  caseId    String         @db.Uuid
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String         @db.Uuid
  user      User           @relation("CaseMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role      CaseMemberRole @default(MEMBER)
  addedById String         @db.Uuid
  addedBy   User           @relation("CaseMemberAddedBy", fields: [addedById], references: [id])
  createdAt DateTime       @default(now())

  @@unique([caseId, userId])
  @@index([userId])
}

model CaseEvent {
  id                String        @id @default(uuid()) @db.Uuid
  caseId            String        @db.Uuid
  case              Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              CaseEventType
  title             String
  description       String?       @db.Text
  eventDate         DateTime
  createdById       String        @db.Uuid
  createdBy         User          @relation(fields: [createdById], references: [id])
  isVisibleToClient Boolean       @default(true)
  createdAt         DateTime      @default(now())

  @@index([caseId, eventDate])
}

model Document {
  id                String           @id @default(uuid()) @db.Uuid
  caseId            String           @db.Uuid
  case              Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name              String
  mimeType          String
  size              Int
  storageKey        String           @unique
  uploadedById      String           @db.Uuid
  uploadedBy        User             @relation(fields: [uploadedById], references: [id])
  isVisibleToClient Boolean          @default(true)
  /// null → uploaded on the client's own initiative; set → a file answering a DocumentRequest
  requestId         String?          @db.Uuid
  request           DocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([caseId])
  @@index([requestId])
}

/// A lawyer asks the client for a specific document; the client answers with files and the lawyer reviews them.
model DocumentRequest {
  id              String                @id @default(uuid()) @db.Uuid
  caseId          String                @db.Uuid
  case            Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedById   String                @db.Uuid
  requestedBy     User                  @relation("DocumentRequestRequester", fields: [requestedById], references: [id])
  title           String
  description     String?               @db.Text
  isRequired      Boolean               @default(true)
  dueDate         DateTime?
  status          DocumentRequestStatus @default(PENDING)
  rejectionReason String?               @db.Text
  reviewedById    String?               @db.Uuid
  reviewedBy      User?                 @relation("DocumentRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  /// Last daily reminder sent for this row (at most one per day).
  lastReminderAt  DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  documents Document[]

  @@index([caseId, status])
  @@index([requestedById])
}

/// Case chat between the client and the staff on the case. readAt is set when the recipient side reads it.
model Message {
  id        String    @id @default(uuid()) @db.Uuid
  caseId    String    @db.Uuid
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  senderId  String    @db.Uuid
  sender    User      @relation(fields: [senderId], references: [id])
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([caseId, createdAt])
}

model Invoice {
  id                     String        @id @default(uuid()) @db.Uuid
  invoiceNumber          String        @unique
  caseId                 String        @db.Uuid
  case                   Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  amount                 Decimal       @db.Decimal(12, 2)
  description            String
  status                 InvoiceStatus @default(DRAFT)
  dueDate                DateTime
  paidAt                 DateTime?
  /// The client reported a bank transfer; staff still has to confirm it.
  paymentMarkedAt        DateTime?
  paymentNote            String?       @db.Text
  /// Last rejected payment report (the invoice went back to SENT).
  paymentRejectedAt      DateTime?
  paymentRejectionReason String?       @db.Text
  /// Staff member who confirmed the payment (paidAt is set at the same time).
  confirmedById          String?       @db.Uuid
  confirmedBy            User?         @relation("InvoiceConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  /// Last daily reminder sent for this row (at most one per day).
  lastReminderAt         DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([caseId, status])
}

// ─── Misc ────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Who caused the notification (null for system or public events such as the contact form).
  actorId   String?  @db.Uuid
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ContactRequest {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

/// Internal staff work item, optionally tied to a case. CLIENT users never see tasks.
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?      @db.Text
  caseId         String?      @db.Uuid
  case           Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assigneeId     String       @db.Uuid
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String       @db.Uuid
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id])
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  /// Last daily reminder sent for this row (at most one per day).
  lastReminderAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments TaskComment[]

  @@index([assigneeId, status])
  @@index([caseId])
  @@index([createdById])
  @@index([status, dueDate])
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}
